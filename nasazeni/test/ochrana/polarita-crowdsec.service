[Unit]
Description=CrowdSec pro soukromou testovací hranu Polarity
After=incus.service polarita-zfs.service
RequiresMountsFor=/srv/polarita/infra/crowdsec-test
[Service]
Type=notify
TimeoutStartSec=15min
# Při běhu offline karantény ponech LAPI paměť pro načtení pravidel.
MemoryMin=96M
MemoryLow=144M
MemorySwapMax=32M
ExecStartPre=/bin/sh -ec 'test -d /var/lib/incus/storage-pools/default/custom/default_stalwart-mx-test-data/log; test -d /var/lib/incus/storage-pools/default/containers/caddy-test/rootfs/var/log/polarita'
ExecStart=/srv/polarita/infra/crowdsec-test/bin/crowdsec -c /srv/polarita/infra/crowdsec-test/conf/config.yaml -no-capi
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/polarita/infra/crowdsec-test/data
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
IPAddressDeny=any
IPAddressAllow=localhost
[Install]
WantedBy=multi-user.target
