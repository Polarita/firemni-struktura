    ["Gitea", "nejméně 12", "https://docs.gitea.com/installation/database-prep/"],
    ["Umami", "nejméně 12.14", "https://docs.umami.is/docs/install"],
    ["Paperless-ngx", "nejméně 14 a podpora podle Django", "https://docs.paperless-ngx.com/administration/"],
    ["Stalwart", "podporovaný backend, chybí výčet hlavních verzí", "https://stalw.art/docs/storage/backends/postgresql/"],
    ["Traccar", "podporovaný JDBC backend, chybí výčet hlavních verzí", "https://www.traccar.org/postgresql/"],
