{
	admin 127.0.0.1:2019
	auto_https disable_redirects
}

(protokol) {
	log {
		output file /var/log/polarita/{args[0]}.json {
			roll_size 8MiB
			roll_keep 4
		}
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
				request>tls delete
				resp_headers delete
			}
		}
	}
}

http://:8080 {
	import protokol reditelstvi
	bind 127.0.0.1
	header +Via "1.1 polarita-caddy"
	route {
		@pamet header_regexp Host ^[a-z0-9.-]+[.]ts[.]net:8446$
		handle @pamet {
			route {
				redir / /pamet/ 302
				redir /pamet /pamet/ 308
				reverse_proxy /pamet/* 10.239.32.19:4180 {
					header_up Cookie "__Secure-pol-vault={http.request.cookie.__Secure-pol-vault}; __Secure-pol-vault_csrf={http.request.cookie.__Secure-pol-vault_csrf}; __Secure-pol-vault_0={http.request.cookie.__Secure-pol-vault_0}; __Secure-pol-vault_1={http.request.cookie.__Secure-pol-vault_1}; __Secure-pol-vault_2={http.request.cookie.__Secure-pol-vault_2}; __Secure-pol-vault_3={http.request.cookie.__Secure-pol-vault_3}; __Secure-pol-vault_4={http.request.cookie.__Secure-pol-vault_4}; __Secure-pol-vault_5={http.request.cookie.__Secure-pol-vault_5}"
					header_up -Authorization
					header_up -X-Auth-Request-Redirect
					header_up X-Forwarded-Proto https
				}
				respond 404
			}
		}
		request_header Cookie "(^|; *)(__Secure-pol-vault[^=;]*)=[^;]*" ""
		@paperclip header_regexp Host ^[a-z0-9.-]+[.]ts[.]net:8445$
		handle @paperclip {
			reverse_proxy 10.239.32.18:3100 {
				header_up Cookie "(^|; *)(__Host-polarita-test|polzulipsid|polzulipcsrf)=[^;]*" ""
				header_up X-Forwarded-Proto https
			}
		}
		request_header Cookie "(^|; *)(__Secure-)?better-auth[.][^=;]+=[^;]*" ""
		@chat header_regexp Host ^[a-z0-9.-]+[.]ts[.]net:8444$
		handle @chat {
			reverse_proxy 10.239.32.16:80 {
				header_up Cookie "(^|; *)__Host-polarita-test=[^;]*" ""
				header_up X-Forwarded-Proto https
			}
		}
		request_header Cookie "(^|; *)(polzulipsid|polzulipcsrf)=[^;]*" ""
		redir /identita /identita/realms/polarita/account/ 302
		@identita path /identita/realms/polarita /identita/realms/polarita/* /identita/resources/*
		reverse_proxy @identita 10.239.32.11:8080 {
			header_up Cookie "(^|; *)__Host-polarita-test=[^;]*" ""
			header_up X-Forwarded-Proto https
		}
		respond /identita/* 404
		redir /git /git/ 308
		handle_path /git/* {
			reverse_proxy 10.239.32.13:3000 {
				header_up Cookie "(^|; *)__Host-polarita-test=[^;]*" ""
				header_up X-Forwarded-Proto https
			}
		}
		redir /hesla /hesla/ 308
		@sprava path /hesla/admin /hesla/admin/*
		respond @sprava 404
		reverse_proxy /hesla/* 10.239.33.11:8080 {
			header_up Cookie "(^|; *)__Host-polarita-test=[^;]*" ""
			header_up X-Forwarded-Proto https
		}
		reverse_proxy 10.239.32.10:8080
	}
}

