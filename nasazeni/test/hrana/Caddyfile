{
	admin 127.0.0.1:2019
	auto_https disable_redirects
}

(protokol) {
	log {
		output file /var/log/polarita/{args[0]}.json {
			roll_size 8MiB
			roll_keep 4
		}
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
				request>tls delete
				resp_headers delete
			}
		}
	}
}

http://:8080 {
	import protokol reditelstvi
	bind 127.0.0.1
	header +Via "1.1 polarita-caddy"
	route {
		redir /identita /identita/realms/polarita/account/ 302
		@identita path /identita/realms/polarita /identita/realms/polarita/* /identita/resources/*
		reverse_proxy @identita 10.239.32.11:8080 {
			header_up Cookie "(^|; *)__Host-polarita-test=[^;]*" ""
			header_up X-Forwarded-Proto https
		}
		respond /identita/* 404
		redir /git /git/ 308
		handle_path /git/* {
			reverse_proxy 10.239.32.13:3000 {
				header_up Cookie "(^|; *)__Host-polarita-test=[^;]*" ""
				header_up X-Forwarded-Proto https
			}
		}
		redir /hesla /hesla/ 308
		@sprava path /hesla/admin /hesla/admin/*
		respond @sprava 404
		reverse_proxy /hesla/* 10.239.33.11:8080 {
			header_up Cookie "(^|; *)__Host-polarita-test=[^;]*" ""
			header_up X-Forwarded-Proto https
		}
		reverse_proxy 10.239.32.10:8080
	}
}

https://vpn.polarita.test:8443 {
	import protokol vpn
	bind 10.239.31.10
	tls internal
	reverse_proxy 10.239.31.11:8080
}
