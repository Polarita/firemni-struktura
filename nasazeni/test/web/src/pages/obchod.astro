<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" /><title>Testovací obchod | Polarita</title>
  <script is:inline src="./nakup.js" defer></script>
</head>
<body>
  <header>Polarita s.r.o.</header>
  <main>
    <h1>Testovací obchod</h1>
    <p>Vyzkoušejte osobní odběr v Ejpovicích. Obchod použije zkušebního zákazníka a místní testovací platbu.</p>
    <p id="stav" role="status" aria-live="polite">Načítám katalog…</p>
    <section id="polozka" hidden>
      <h2 id="nazev"></h2>
      <p id="popis"></p>
      <p><strong id="cena"></strong> za kus</p>
      <button id="pridat" type="button">Vložit jeden kus do košíku</button>
    </section>
    <section id="kosik" hidden>
      <h2>Košík</h2>
      <p id="radek"></p><p id="doprava"></p>
      <p>Celkem <strong id="celkem"></strong></p>
      <button id="odeslat" type="button">Odeslat testovací objednávku</button>
    </section>
    <section id="potvrzeno" hidden><h2>Objednávka přijata</h2><p id="doklad"></p>
      <button id="novy" type="button">Začít nový nákup</button>
    </section>
    <button id="opakovat" type="button" hidden>Načíst znovu</button>
  </main>
  <style>
    :root{font-family:Inter,system-ui,sans-serif;color:#1c2d35;background:#f4f5ef;line-height:1.5}
    body{margin:0}header{padding:1rem max(1.3rem,calc((100vw - 47rem)/2));background:#163a38;color:white;font-weight:650}
    main{max-width:47rem;margin:2.5rem auto;padding:0 1.3rem}h1,h2{line-height:1.15}
    h1{font-size:clamp(2rem,6vw,3.2rem)}h2{margin-top:0}
    section{background:white;border:1px solid #d4ded6;padding:1.4rem;margin:1rem 0}
    button{font:inherit;font-weight:600;padding:.7rem 1rem;background:#175d4d;color:white;border:0;border-radius:.25rem;cursor:pointer}
    button:disabled{opacity:.55;cursor:wait}button:focus-visible{outline:3px solid #9c6100;outline-offset:3px}
    #stav:empty{display:none}
  </style>
</body></html>
