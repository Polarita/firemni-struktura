#!/bin/bash
set -euo pipefail
while read -r old new ref; do
    [[ $new =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] || exit 1
    if [[ $new =~ ^0+$ ]]; then continue; fi
    result=0
    timeout 90 gitleaks detect --exit-code 23 --no-banner --redact --config=/etc/polarita-gitea/gitleaks.toml \
        --source=. --log-opts="$new --not --all" >/dev/null 2>&1 || result=$?
    if [[ $result == 23 ]]; then
        echo 'Polarita TEST: gitleaks nepovolil přijetí změny.' >&2
        exit 1
    elif [[ $result != 0 ]]; then
        echo "Polarita TEST: kontrola gitleaks selhala." >&2
        exit 1
    fi
done
