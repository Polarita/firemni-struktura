[Unit]
Description=Paperclip pro testovací ředitelství Polarity
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=4

[Service]
Type=simple
User=paperclip
Group=paperclip
WorkingDirectory=/opt/paperclip/current
Environment=HOME=/var/lib/paperclip
Environment=PAPERCLIP_HOME=/var/lib/paperclip
Environment=PATH=/opt/node/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=PAPERCLIP_TELEMETRY_DISABLED=1
Environment=NODE_OPTIONS=--max-old-space-size=384
Environment=NODE_EXTRA_CA_CERTS=/etc/polarita-paperclip/postgres.crt
Environment=PAPERCLIP_DEPLOYMENT_MODE=authenticated
Environment=PAPERCLIP_DEPLOYMENT_EXPOSURE=private
Environment=HOST=127.0.0.1
Environment=PORT=3100
Environment=PAPERCLIP_AUTH_BASE_URL_MODE=explicit
Environment=PAPERCLIP_MIGRATION_AUTO_APPLY=true
Environment=PAPERCLIP_DB_BACKUP_ENABLED=false
Environment=HEARTBEAT_SCHEDULER_ENABLED=false
EnvironmentFile=/etc/polarita-paperclip/server.env
LoadCredential=postgres:/run/secrets/pg-db_paperclip
LoadCredential=auth:/run/secrets/paperclip-auth
LoadCredential=jwt:/run/secrets/paperclip-jwt
LoadCredential=master:/run/secrets/paperclip-master
ExecStart=/bin/bash /etc/polarita-paperclip/start.sh
Restart=on-failure
RestartSec=10
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/paperclip
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
