[Unit]
Description=Medusa – interní testovací e-shop Polarity
After=network-online.target
Wants=network-online.target
[Service]
User=medusa
Group=medusa
WorkingDirectory=/opt/medusa/current/.medusa/server
Environment=PATH=/opt/node/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=MEDUSA_DISABLE_TELEMETRY=true
Environment=NODE_OPTIONS=--max-old-space-size=550
Environment=HOME=/var/lib/medusa
StateDirectory=medusa
ExecStartPre=/usr/bin/test -s /run/secrets/pg-db_eshop
ExecStart=/opt/node/bin/node /opt/medusa/current/node_modules/@medusajs/cli/cli.js start --host 127.0.0.1 --port 9000
Restart=on-failure
RestartSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
[Install]
WantedBy=multi-user.target
