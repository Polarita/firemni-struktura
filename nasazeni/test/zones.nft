destroy table inet polarita_test
table inet polarita_test {
    set zones {
        type ifname
        elements = { "app_internal", "data_vault", "dmz_edge" }
    }
    set klienti_trezoru_dmz {
        type ipv4_addr
        elements = { 10.239.31.10, 10.239.31.11, 10.239.31.12 }
    }
    chain forwarding {
        type filter hook forward priority -20; policy accept;
        # Provoz mezi dvěma porty stejného DMZ mostu dále filtruje tabulka CrowdSec.
        iifname "dmz_edge" oifname "dmz_edge" accept
        iifname "dmz_edge" oifname "app_internal" ip saddr 10.239.31.10 ip daddr { 10.239.32.10, 10.239.32.11 } tcp dport 8080 ct state new,established counter accept
        iifname "app_internal" oifname "dmz_edge" ip saddr { 10.239.32.10, 10.239.32.11 } ip daddr 10.239.31.10 tcp sport 8080 ct state established counter accept
        iifname "dmz_edge" oifname "app_internal" ip saddr 10.239.31.10 ip daddr 10.239.32.13 tcp dport 3000 ct state new,established counter accept
        iifname "app_internal" oifname "dmz_edge" ip saddr 10.239.32.13 ip daddr 10.239.31.10 tcp sport 3000 ct state established counter accept
        iifname "dmz_edge" oifname "data_vault" ip saddr 10.239.31.10 ip daddr 10.239.33.11 tcp dport 8080 ct state new,established counter accept
        iifname "data_vault" oifname "dmz_edge" ip saddr 10.239.33.11 ip daddr 10.239.31.10 tcp sport 8080 ct state established counter accept
        iifname "dmz_edge" oifname "data_vault" ip saddr @klienti_trezoru_dmz ip daddr 10.239.33.10 tcp dport 8200 ct state new,established counter accept
        iifname "data_vault" oifname "dmz_edge" ip saddr 10.239.33.10 ip daddr @klienti_trezoru_dmz tcp sport 8200 ct state established counter accept
        iifname "app_internal" oifname "data_vault" ip saddr { 10.239.32.10, 10.239.32.11, 10.239.32.12, 10.239.32.13, 10.239.32.16, 10.239.32.17, 10.239.32.18, 10.239.32.20, 10.239.32.21, 10.239.32.22, 10.239.32.23, 10.239.32.24 } ip daddr 10.239.33.10 tcp dport 8200 ct state new,established counter accept
        iifname "data_vault" oifname "app_internal" ip saddr 10.239.33.10 ip daddr { 10.239.32.10, 10.239.32.11, 10.239.32.12, 10.239.32.13, 10.239.32.16, 10.239.32.17, 10.239.32.18, 10.239.32.20, 10.239.32.21, 10.239.32.22, 10.239.32.23, 10.239.32.24 } tcp sport 8200 ct state established counter accept
        iifname "data_vault" oifname "data_vault" ip saddr { 10.239.33.11, 10.239.33.12, 10.239.33.13, 10.239.33.14 } ip daddr 10.239.33.10 tcp dport 8200 ct state new,established counter accept
        iifname "data_vault" oifname "data_vault" ip saddr 10.239.33.10 ip daddr { 10.239.33.11, 10.239.33.12, 10.239.33.13, 10.239.33.14 } tcp sport 8200 ct state established counter accept
        iifname "app_internal" oifname "data_vault" ip saddr { 10.239.32.11, 10.239.32.13, 10.239.32.16, 10.239.32.18, 10.239.32.20, 10.239.32.21, 10.239.32.22, 10.239.32.23, 10.239.32.24 } ip daddr 10.239.33.12 tcp dport 5432 ct state new,established counter accept
        iifname "data_vault" oifname "app_internal" ip saddr 10.239.33.12 ip daddr { 10.239.32.11, 10.239.32.13, 10.239.32.16, 10.239.32.18, 10.239.32.20, 10.239.32.21, 10.239.32.22, 10.239.32.23, 10.239.32.24 } tcp sport 5432 ct state established counter accept
        iifname "app_internal" oifname "data_vault" ip saddr { 10.239.32.16, 10.239.32.24 } ip daddr 10.239.33.13 tcp dport 6379 ct state new,established counter accept
        iifname "data_vault" oifname "app_internal" ip saddr 10.239.33.13 ip daddr { 10.239.32.16, 10.239.32.24 } tcp sport 6379 ct state established counter accept
        iifname "dmz_edge" oifname "app_internal" ip saddr 10.239.31.10 ip daddr 10.239.32.21 tcp dport 8000 ct state new,established counter accept
        iifname "app_internal" oifname "dmz_edge" ip saddr 10.239.32.21 ip daddr 10.239.31.10 tcp sport 8000 ct state established counter accept
        iifname "dmz_edge" oifname "app_internal" ip saddr 10.239.31.10 ip daddr 10.239.32.20 tcp dport 3456 ct state new,established counter accept
        iifname "app_internal" oifname "dmz_edge" ip saddr 10.239.32.20 ip daddr 10.239.31.10 tcp sport 3456 ct state established counter accept
        iifname "dmz_edge" oifname "app_internal" ip saddr 10.239.31.10 ip daddr 10.239.32.19 tcp dport 4180 ct state new,established counter accept
        iifname "app_internal" oifname "dmz_edge" ip saddr 10.239.32.19 ip daddr 10.239.31.10 tcp sport 4180 ct state established counter accept
        iifname "dmz_edge" oifname "app_internal" ip saddr 10.239.31.10 ip daddr 10.239.32.18 tcp dport 3100 ct state new,established counter accept
        iifname "app_internal" oifname "dmz_edge" ip saddr 10.239.32.18 ip daddr 10.239.31.10 tcp sport 3100 ct state established counter accept
        iifname "dmz_edge" oifname "app_internal" ip saddr 10.239.31.10 ip daddr 10.239.32.16 tcp dport 80 ct state new,established counter accept
        iifname "app_internal" oifname "dmz_edge" ip saddr 10.239.32.16 ip daddr 10.239.31.10 tcp sport 80 ct state established counter accept
        iifname @zones counter drop
        oifname @zones counter drop
    }
    chain local_input {
        type filter hook input priority -20; policy accept;
        iifname "dmz_edge" ip saddr 10.239.31.10 ip daddr 10.239.31.1 tcp dport { 18449, 18450 } counter accept
        ip daddr 10.239.31.1 tcp dport { 18449, 18450 } counter drop
        iifname @zones ct state established,related accept
        iifname "dmz_edge" ip saddr 10.239.31.13 ip daddr 10.239.31.1 tcp dport 443 ct state new,established accept
        iifname "dmz_edge" ip daddr 10.239.31.1 udp dport 53 accept
        iifname "dmz_edge" ip daddr 10.239.31.1 tcp dport 53 accept
        iifname "app_internal" ip saddr 10.239.32.16 ip daddr 10.239.32.1 udp dport 53 accept
        iifname "app_internal" ip saddr 10.239.32.16 ip daddr 10.239.32.1 tcp dport 53 accept
        iifname @zones udp sport 68 udp dport 67 accept
        iifname @zones counter drop
    }
}
